{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "packages/providers/src",
    "packages/permissions/src",
    "packages/permissions/host-deps.ts"
  ],
  "exclude": [
    "packages/providers/src/**/*.test.ts",
    "packages/providers/src/testing"
  ]
}
