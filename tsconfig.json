{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "packages/providers/src",
    "packages/permissions/src",
    "packages/permissions/host-deps.ts",
    "packages/prompt/src"
  ],
  "exclude": [
    "packages/providers/src/**/*.test.ts",
    "packages/providers/src/testing",
    // SessionManager and the modules that moved with it are typechecked by the desktop against its real
    // types (docs/engine.md); here they only compile, because the desktop-only host types are open shapes.
    "packages/providers/src/engine",
    "src/session-engine.ts"
  ]
}
