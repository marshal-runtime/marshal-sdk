{
  "name": "@marshal/sdk",
  "version": "0.0.1",
  "private": true,
  "description": "A Marshal host without the desktop app: the portable runtime, extensions, Marshal sessions on the Claude Agent SDK.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "marshal-sdk": "dist/src/cli.js",
    "marshal-claude": "dist/src/claude-bridge-cli.js"
  },
  "scripts": {
    "build": "node build.mjs && node extensions/org/build.mjs",
    "test": "node build.mjs && node extensions/org/build.mjs && node --test \"dist/test/*.test.js\"",
    "image": "node image/prepare.mjs",
    "pack": "node image/pack.mjs",
    "vendor:packs": "node scripts/vendor-packs.mjs",
    "check:packs": "node build.mjs && node scripts/check-packs.mjs",
    "typecheck": "tsc -p tsconfig.json && node scripts/typecheck-host.mjs",
    "vendor:host": "node scripts/vendor-desktop-host.mjs sync"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@cursor/sdk": "1.0.35",
    "@marshal/agent-runtime-claude": "file:vendor/packs/marshal-agent-runtime-claude-0.1.0-marshal-host-96.tgz",
    "@marshal/agent-runtime-org": "file:vendor/packs/marshal-agent-runtime-org-0.1.0-marshal-host-96.tgz",
    "@marshal/agent-runtime-prompt": "file:vendor/packs/marshal-agent-runtime-prompt-0.1.0-marshal-host-97.tgz",
    "@marshal/runtime": "file:vendor/packs/marshal-runtime-0.1.0-marshal-host-96.tgz",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/agents": "0.22.0",
    "@openai/codex": "0.162.1",
    "@playwright/mcp": "0.0.68",
    "playwright-core": "1.59.0-alpha-1771104257000",
    "zod": "4.3.6",
    "@marshal/agentic-debugger-extension": "file:vendor/packs/marshal-agentic-debugger-extension-1.0.0-marshal-host-1.tgz",
    "@marshal/overlay-review": "file:vendor/packs/marshal-overlay-review-0.1.0-marshal-host-2.tgz",
    "@marshal/swarm": "file:vendor/packs/marshal-swarm-0.1.0-marshal-host-51.tgz",
    "ws": "^8.20.1",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "esbuild": "^0.27.4",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@marshal/agent-runtime-claude": "file:vendor/packs/marshal-agent-runtime-claude-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-code-intelligence": "file:vendor/packs/marshal-agent-runtime-code-intelligence-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-composer": "file:vendor/packs/marshal-agent-runtime-composer-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-conformance": "file:vendor/packs/marshal-agent-runtime-conformance-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-core": "file:vendor/packs/marshal-agent-runtime-core-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-delegation": "file:vendor/packs/marshal-agent-runtime-delegation-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-effects": "file:vendor/packs/marshal-agent-runtime-effects-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-extensions": "file:vendor/packs/marshal-agent-runtime-extensions-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-host": "file:vendor/packs/marshal-agent-runtime-host-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-manifest": "file:vendor/packs/marshal-agent-runtime-manifest-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-org": "file:vendor/packs/marshal-agent-runtime-org-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-permissions": "file:vendor/packs/marshal-agent-runtime-permissions-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-prompt": "file:vendor/packs/marshal-agent-runtime-prompt-0.1.0-marshal-host-97.tgz",
      "@marshal/agent-runtime-provider-artifacts": "file:vendor/packs/marshal-agent-runtime-provider-artifacts-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-provider-kit": "file:vendor/packs/marshal-agent-runtime-provider-kit-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-typescript": "file:vendor/packs/marshal-agent-runtime-typescript-0.1.0-marshal-host-96.tgz",
      "@marshal/agent-runtime-ui": "file:vendor/packs/marshal-agent-runtime-ui-0.1.0-marshal-host-96.tgz",
      "@marshal/agentic-debugger-extension": "file:vendor/packs/marshal-agentic-debugger-extension-1.0.0-marshal-host-1.tgz",
      "@marshal/overlay-review": "file:vendor/packs/marshal-overlay-review-0.1.0-marshal-host-2.tgz",
      "@marshal/runtime": "file:vendor/packs/marshal-runtime-0.1.0-marshal-host-96.tgz",
      "@marshal/swarm": "file:vendor/packs/marshal-swarm-0.1.0-marshal-host-51.tgz"
    }
  }
}
